DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
JWT_SECRET=replace_with_a_long_random_secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_before_starting
# Comma-separated browser origins. Native Expo clients do not need an Origin header.
CORS_ORIGIN=http://localhost:8081
# The existing database uses Iventory. Change only if your table has a different name.
INVENTORY_TABLE=Inventory
